# auto: demo quando não há NYT_API_KEY; demo: sempre fictício; live: exige chave.
NEWS_MODE=auto
NYT_API_KEY=
DEEPL_API_KEY=
# free ou pro (não aceita URL arbitrária)
DEEPL_PLAN=free
NEWS_CACHE_SECONDS=300
TRANSLATION_CACHE_SECONDS=86400
# Limites por instância; veja as limitações de hospedagem no README.
NYT_MIN_INTERVAL_MS=12000
NYT_DAILY_LIMIT=500
TRANSLATION_REQUESTS_PER_MINUTE=12
TRANSLATION_CHARACTERS_PER_DAY=10000
